# Copy to ~/.coding-router-jev.env. Existing shell environment variables take precedence.

# The TypeSafe SDK reads these directly from process.env.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=
# TYPESAFE_DEFAULT_MODEL=

# Pi provider login: Pi authenticates against the model provider (e.g. OpenAI
# Codex subscription) through its own provider login flow (`pi provider login
# openai-codex`). This is separate from TYPESAFE_API_KEY, which the JEV
# classifier reads directly. Both credentials are required for Pi routing:
# the provider credential for inference and the TypeSafe key for classification.

# Codex model aliases (defaults shown)
# CODING_ROUTER_FAST_MODEL_CODEX=chatgpt-6-luna
# CODING_ROUTER_BALANCED_MODEL_CODEX=chatgpt-6.1-sol
# CODING_ROUTER_STRONG_MODEL_CODEX=chatgpt-6.1-sol
# CODING_ROUTER_LONG_MODEL_CODEX=chatgpt-6-astra
# CODING_ROUTER_LONG_MODEL_ENABLE=false

# Pi model aliases (defaults shown). Provider-qualified IDs use provider/model
# format; the first slash separates the provider prefix from the model name.
# CODING_ROUTER_FAST_MODEL_PI=openai-codex/gpt-6-luna
# CODING_ROUTER_BALANCED_MODEL_PI=openai-codex/gpt-6.1-sol
# CODING_ROUTER_STRONG_MODEL_PI=openai-codex/gpt-6.1-sol
# CODING_ROUTER_LONG_MODEL_PI=openai-codex/gpt-6-astra

# Claude custom Anthropic-compatible endpoint (also used by ordinary Claude).
# claude-jev captures this upstream before pointing its child at the local proxy.
# ANTHROPIC_BASE_URL=https://your-anthropic-compatible-server

# Claude model aliases (defaults shown). These are used by the claude-jev
# launcher for Anthropic Messages API routing.
# CODING_ROUTER_FAST_MODEL_CLAUDE=claude-haiku-4-5-20251001
# CODING_ROUTER_BALANCED_MODEL_CLAUDE=claude-sonnet-5-5
# CODING_ROUTER_STRONG_MODEL_CLAUDE=claude-opus-5-5
# CODING_ROUTER_LONG_MODEL_CLAUDE=claude-fable-5-1

# Initial tier for new conversations and after restart. Allowed: fast, balanced,
# strong, long. Invalid or blank defaults to fast. long with Long disabled falls
# back to fast. Existing tier/model aliases determine the actual startup model.
# CODING_ROUTER_START_TIER=fast

# CODING_ROUTER_MIN_CONFIDENCE=0.30
# CODING_ROUTER_SEND_RECENT_CONTEXT=true

# Delete session JSONL logs older than this many days at startup.
# Unset, blank, zero, or negative: no logs are deleted.
# CODING_ROUTER_LOG_RETENTION_DAYS=30

# Automatic jev-logs skill installation. Set to false to disable.
# The skill is installed at $CODEX_HOME/skills/jev-logs/SKILL.md
# (fallback: ~/.codex/skills/jev-logs/SKILL.md).
# CODING_ROUTER_JEV_LOGS_SKILL_INSTALL=true

# Feedback notice format. Supported placeholders (braces required):
#   {tier}              — selected tier (fast, balanced, strong, long)
#   {model}             — selected model ID
#   {effort}            — reasoning effort ("default" when unavailable)
#   {decision}          — routing decision label (e.g. JEV, override)
#   {confidence}        — decision confidence (0.00–1.00, or "unavailable")
#   {previous_model}    — model before this routing decision
#   {cache_read}        — last response cache-read tokens ("unavailable" if unknown)
#   {cache_write}       — last response cache-write tokens ("unavailable" if unknown)
#   {jev_tokens_input}  — JEV request input tokens ("unavailable" if unknown)
#   {jev_tokens_output} — JEV request output tokens ("unavailable" if unknown)
#   {jev_tokens}        — JEV total tokens (only when both input+output reported)
# Unknown placeholders are left as-is. Missing values render as "unavailable".
# CODING_ROUTER_FEEDBACK_FORMAT=[Jev] tier: {tier}, model: {model}, effort: {effort}; decision: {decision}, confidence: {confidence}.

# Status/footer format for Codex, Claude, and Pi (independent from response feedback).
# CODING_ROUTER_STATUS_FORMAT=[Jev] {model} · {effort}
# Status/footer is off by default; response feedback is on by default.
# Codex uses "Coding Router Jev" for {model} and adds effort natively.
# STATUS_SHOW affects Claude/Pi only; Codex always keeps its model-picker label visible.
# CODING_ROUTER_STATUS_SHOW=false
# CODING_ROUTER_FEEDBACK_SHOW=true
