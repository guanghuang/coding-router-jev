{
  "name": "coding-router-jev",
  "version": "0.1.1",
  "private": true,
  "description": "Routes Codex turns through JEV with configurable models and reasoning effort",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codex-jev": "src/cli.ts",
    "claude-jev": "src/claude-cli.ts",
    "jev-logs": "src/jev-logs.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --compile --outfile dist/codex-jev && bun build src/claude-cli.ts --compile --outfile dist/claude-jev && bun build src/jev-logs.ts --compile --outfile dist/jev-logs",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3",
    "typebox": "^1.3.34"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "typebox": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "pi": {
    "extensions": ["./src/pi-extension.ts"],
    "skills": ["./skills/pi/jev-logs"]
  }
}
